{
  "openapi": "3.0.3",
  "info": {
    "title": "LMS append-only log API",
    "version": "0.1.0",
    "description": "Correctness baseline. Not full Splunk/Elasticsearch compatibility. At-least-once delivery; no exactly-once or production capacity guarantee. Wire and decoded request limits: 4 MiB."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080"
    }
  ],
  "paths": {
    "/v1/logs": {
      "post": {
        "summary": "Append a native event batch",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Storage-confirmed success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credential"
          },
          "413": {
            "description": "Body limit or decoding failure"
          },
          "429": {
            "description": "Admission limit"
          },
          "503": {
            "description": "Unconfirmed storage result or query failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dataset",
                  "events"
                ],
                "properties": {
                  "dataset": {
                    "type": "string"
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4096,
                    "items": {
                      "type": "object",
                      "required": [
                        "message"
                      ],
                      "properties": {
                        "message": {
                          "type": "string",
                          "minLength": 1
                        },
                        "@timestamp": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "service": {
                          "type": "string"
                        },
                        "host": {
                          "type": "string"
                        },
                        "source_id": {
                          "type": "string"
                        },
                        "severity": {
                          "type": "string"
                        },
                        "trace_id": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/services/collector": {
      "post": {
        "summary": "Append HEC event objects (subset)",
        "security": [
          {
            "hec": []
          }
        ],
        "responses": {
          "200": {
            "description": "Storage-confirmed success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credential"
          },
          "413": {
            "description": "Body limit or decoding failure"
          },
          "429": {
            "description": "Admission limit"
          },
          "503": {
            "description": "Unconfirmed storage result or query failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "description": "One or more concatenated HEC JSON event objects; event string/object; optional time, host, source, sourcetype, index, fields. Whole-request validation. Raw and ACK are unsupported."
              }
            }
          }
        }
      }
    },
    "/services/collector/event": {
      "post": {
        "summary": "Append HEC event objects (subset)",
        "security": [
          {
            "hec": []
          }
        ],
        "responses": {
          "200": {
            "description": "Storage-confirmed success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credential"
          },
          "413": {
            "description": "Body limit or decoding failure"
          },
          "429": {
            "description": "Admission limit"
          },
          "503": {
            "description": "Unconfirmed storage result or query failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "description": "One or more concatenated HEC JSON event objects; event string/object; optional time, host, source, sourcetype, index, fields. Whole-request validation. Raw and ACK are unsupported."
              }
            }
          }
        }
      }
    },
    "/_bulk": {
      "post": {
        "summary": "Append Bulk index items (subset)",
        "security": [
          {
            "bulk": []
          }
        ],
        "responses": {
          "200": {
            "description": "Storage-confirmed success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credential"
          },
          "413": {
            "description": "Body limit or decoding failure"
          },
          "429": {
            "description": "Admission limit"
          },
          "503": {
            "description": "Unconfirmed storage result or query failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-ndjson": {
              "schema": {
                "type": "string",
                "description": "NDJSON with final newline. Only index without _id; items may fail inside HTTP 200. Maximum 4096 actions. Default dataset is first credential grant when path/_index absent."
              }
            }
          }
        }
      }
    },
    "/{dataset}/_bulk": {
      "parameters": [
        {
          "name": "dataset",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Append Bulk index items to a dataset",
        "security": [
          {
            "bulk": []
          }
        ],
        "responses": {
          "200": {
            "description": "Storage-confirmed success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credential"
          },
          "413": {
            "description": "Body limit or decoding failure"
          },
          "429": {
            "description": "Admission limit"
          },
          "503": {
            "description": "Unconfirmed storage result or query failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-ndjson": {
              "schema": {
                "type": "string",
                "description": "NDJSON with final newline. Only index without _id; items may fail inside HTTP 200. Maximum 4096 actions. Default dataset is first credential grant when path/_index absent."
              }
            }
          }
        }
      }
    },
    "/v1/logs/search": {
      "post": {
        "summary": "Search one tenant and dataset; max 10-day interval",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered events and tenant/query-bound next_cursor; not snapshot pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events",
                    "next_cursor"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "next_cursor": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credential"
          },
          "413": {
            "description": "Body limit or decoding failure"
          },
          "429": {
            "description": "Admission limit"
          },
          "503": {
            "description": "Unconfirmed storage result or query failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dataset",
                  "from",
                  "to",
                  "limit"
                ],
                "properties": {
                  "dataset": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "service": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "trace_id": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "contains": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "cursor": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Process liveness",
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Storage/table readiness",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Storage/table unavailable"
          }
        }
      }
    },
    "/services/collector/raw": {
      "post": {
        "summary": "Explicitly unsupported in this slice",
        "security": [
          {
            "hec": []
          }
        ],
        "responses": {
          "501": {
            "description": "Not implemented"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/services/collector/ack": {
      "post": {
        "summary": "Explicitly unsupported in this slice",
        "security": [
          {
            "hec": []
          }
        ],
        "responses": {
          "501": {
            "description": "Not implemented"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "hec": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Splunk <opaque-token>"
      },
      "bulk": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "ApiKey <opaque-token>; not an Elasticsearch-issued key"
      }
    }
  }
}
